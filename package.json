{
  "name": "aeza-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Aeza API (my.aeza.ru/api/v2)",
  "license": "MIT",
  "author": "Roman Timoshkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdydygin/aeza-mcp.git"
  },
  "homepage": "https://github.com/rdydygin/aeza-mcp#readme",
  "bugs": "https://github.com/rdydygin/aeza-mcp/issues",
  "keywords": ["aeza", "mcp", "model-context-protocol", "vps", "hosting"],
  "type": "module",
  "bin": {
    "aeza-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run typecheck && bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
